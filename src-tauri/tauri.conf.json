{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Strafe-Evolution",
    "version": "1.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": true
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Strafe Evolution",
        "width": 800,
        "height": 620,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "index.html?overlay=true",
        "title": "Strafe Evolution Overlay",
        "width": 270,
        "height": 135,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.strafe-eval.app",
      "icon": [
        "icons/icon.ico"
      ]
    }
  }
}
